/bin/
*.test
*.out
vendor/
.env
kubeconfig

# Runtime data
/data/

# air live-reload build output
/tmp/

# Frontend build artifacts
/web/node_modules/
/web/dist/*
!/web/dist/.gitkeep

# Wails generated output. wailsjs/ is regenerated by every `wails build`/`wails
# dev`; the frontend must not import from it, or the plain browser build (which
# never runs the Wails CLI) would break. Reach Wails through the injected
# `window.runtime` global behind a fallback instead.
/web/wailsjs/
/web/package.json.md5
/cmd/kscope-desktop/build/bin/

# Packaged artifacts (scripts/package.sh). Note build/appicon.png above it is
# deliberately tracked — Wails and the .rpm/.deb both source the icon there.
/dist/
